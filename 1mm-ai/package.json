{
  "name": "1mm-ai",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @1mm/database db:generate",
    "db:migrate": "pnpm --filter @1mm/database db:migrate",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.5"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "openai>zod": "^4"
      }
    }
  }
}
