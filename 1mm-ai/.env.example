# ------------------------------------------------------------------
# 1MM AI – environment variables
# Copy to .env (root) and apps/web/.env.local, then fill in values.
# NEVER commit real values. Only NEXT_PUBLIC_*/EXPO_PUBLIC_* variables
# are safe to expose to clients – everything else is server-only.
# ------------------------------------------------------------------

# PostgreSQL (pgvector extension required). DIRECT_URL is used for
# migrations when DATABASE_URL points at a connection pooler.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onemm_ai
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/onemm_ai

# OpenAI – server-side ONLY. Never expose to the browser or mobile app.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Public URL of the web app (safe for clients).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign session tokens (JWT). Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Optional: Supabase Auth (alternative auth provider – not required for
# the built-in email/password auth). Service role key is server-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set to "1" to run the app against a deterministic mock AI provider
# (no OpenAI key required; used by e2e tests).
MOCK_AI=

# Mobile app (Expo): base URL of the API (safe for clients).
EXPO_PUBLIC_API_URL=http://localhost:3000
