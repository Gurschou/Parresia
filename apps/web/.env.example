# Demo mode: scripted, realistic responses without any API keys.
# SYNAPSE_DEMO=1

# SYNAPSE model provider keys — configure at least one.
# Missing providers are skipped by the Model Router; with no keys at all
# SYNAPSE runs in offline mock mode.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# Optional model overrides (defaults: claude-sonnet-5, gpt-4o,
# gemini-2.0-flash, mistral-large-latest)
ANTHROPIC_MODEL=
OPENAI_MODEL=
GOOGLE_MODEL=
MISTRAL_MODEL=

# Optional OpenAI-compatible open source endpoint (vLLM, Ollama, …)
OSS_BASE_URL=
OSS_API_KEY=
OSS_MODEL=
