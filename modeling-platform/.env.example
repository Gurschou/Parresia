# ─────────────────────────────────────────────────────────────
# Behavioral Modeling Platform — miljøvariabler
# Kopiér til .env (rod) og/eller apps/web/.env.local
# ─────────────────────────────────────────────────────────────

# ── LLM (analyse) ────────────────────────────────────────────
# anthropic | mock   (mock kræver ingen nøgle — til lokal udvikling og tests)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Default: claude-opus-5-5 (aktuel Opus). Fx claude-sonnet-5-5 for lavere pris.
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max | off
ANTHROPIC_EFFORT=high
# adaptive | off
ANTHROPIC_THINKING=adaptive
# default | off — server-side fallback-model hvis Claude afviser anmodningen
ANTHROPIC_FALLBACKS=default
ANTHROPIC_MAX_TOKENS=64000
# schema (structured outputs) | prompt (schema i prompten + lokal validering)
STRUCTURED_OUTPUT=schema

# ── Rate-limiting og robusthed mod Claude ─────────────────────
LLM_MAX_CONCURRENCY=2
LLM_REQUESTS_PER_MINUTE=20
LLM_MAX_RETRIES=4
LLM_TIMEOUT_MS=900000
MAX_TRANSCRIPT_CHARS=600000
# Kvote pr. bruger i web-appen (analyser pr. time)
USER_ANALYSES_PER_HOUR=20

# ── Transskribering (lyd/video) ──────────────────────────────
# openai | assemblyai | whisper-local | mock
TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=
# whisper-1 | gpt-4o-transcribe | gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_MODEL=whisper-1
ASSEMBLYAI_API_KEY=
# Lokal whisper.cpp: sti til binær og model (ggml-*.bin)
WHISPER_CPP_BIN=whisper-cli
WHISPER_CPP_MODEL=./models/ggml-base.bin
# Sprog-hint (ISO 639-1). Tom = auto-detektion.
TRANSCRIPTION_LANGUAGE=da
# Sti til ffmpeg/ffprobe hvis de ikke er på PATH
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_UPLOAD_MB=500

# ── Web: database og auth ────────────────────────────────────
# Lokale data (PGlite + uploads). Ligger bevidst uden for projektet, så
# Next' dev-watcher ikke genindlæser ved hver databaseskrivning.
# Tom = ~/.parresia-modeling
DATA_DIR=
# Tom = PGlite (Postgres i $DATA_DIR/pglite — ingen installation).
# Produktion: postgres://user:pass@host:5432/db
DATABASE_URL=
# Generér med: openssl rand -base64 32
AUTH_SECRET=
# 1 = vis "Prøv demoen"-knap på login (demokontoen fra `pnpm db:seed`). Kun til demo/preview!
DEMO_LOGIN=
# Kun nødvendig bag proxy/i produktion
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Mappe til uploadede lydfiler (default $DATA_DIR/uploads; slettes efter transskribering)
UPLOAD_DIR=
